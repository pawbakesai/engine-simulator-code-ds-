#include <iostream>
#include <string>
using namespace std;

struct Stroke {
    string name;
    double pressure;
    double volume;
    double compressionRatio;
    Stroke* next;
};

Stroke* createStroke(string name, double pressure,
                     double volume, double ratio) {
    Stroke* node = new Stroke;
    node->name = name;
    node->pressure = pressure;
    node->volume = volume;
    node->compressionRatio = ratio;
    node->next = NULL;
    return node;
}

void displayStroke(Stroke* current) {
    cout << "\nStroke: " << current->name << endl;
    cout << "Pressure: " << current->pressure << endl;
    cout << "Volume: " << current->volume << endl;
    cout << "Compression Ratio: "
         << current->compressionRatio << endl;
}

void updateState(Stroke* current) {
    // Example values are used for data-structure demonstration.
    if (current->name == "Intake") {
        current->pressure = 1.0;
        current->volume = 500.0;
    } else if (current->name == "Compression") {
        current->pressure = 8.0;
        current->volume = 80.0;
    } else if (current->name == "Power") {
        current->pressure = 35.0;
        current->volume = 450.0;
    } else if (current->name == "Exhaust") {
        current->pressure = 1.2;
        current->volume = 500.0;
    }
}

void deleteCycle(Stroke* head) {
    if (head == NULL) return;

    Stroke* current = head->next;
    while (current != head) {
        Stroke* nextNode = current->next;
        delete current;
        current = nextNode;
    }
    delete head;
}

int main() {
    Stroke* intake = createStroke("Intake", 1.0, 500.0, 8.0);
    Stroke* compression = createStroke("Compression", 8.0, 80.0, 8.0);
    Stroke* power = createStroke("Power", 35.0, 450.0, 8.0);
    Stroke* exhaust = createStroke("Exhaust", 1.2, 500.0, 8.0);

    intake->next = compression;
    compression->next = power;
    power->next = exhaust;
    exhaust->next = intake; // Last node points back to head.

    Stroke* current = intake;
    char choice = 'y';

    cout << "4-Stroke Engine Combustion Cycle Simulator\n";

    while (choice == 'y' || choice == 'Y') {
        updateState(current);
        displayStroke(current);
        current = current->next;

        cout << "\nContinue to next stroke? (y/n): ";
        cin >> choice;
    }

    deleteCycle(intake);
    cout << "\nEngine simulation stopped. Memory released.\n";
    return 0;
}

            
   



   
        

    
